# ---------------------------------------------------------------------------
# L1 Academy / lms.phoneme.in — environment file
# Install at /etc/lms/lms.env, owned root:lms, mode 640. Never commit the real file.
# ---------------------------------------------------------------------------

# --- process
PORT=4173
HOST=127.0.0.1
APP_BASE_URL=https://lms.phoneme.in

# SQLite lives outside the code directory so deploys never touch it.
DB_PATH=/var/lib/lms/app.db

# --- Phoneme Auth (OIDC) -----------------------------------------------------
# Register this client with the Phoneme Auth team, then paste the values here.
# Redirect URI to register (exact match): https://lms.phoneme.in/auth/callback
PHONEME_AUTH_ENABLED=1
PHONEME_AUTH_ISSUER=https://auth.phoneme.in
PHONEME_AUTH_CLIENT_ID=lms
PHONEME_AUTH_CLIENT_SECRET=REPLACE_WITH_SECRET_FROM_AUTH_TEAM
PHONEME_AUTH_REDIRECT_URI=https://lms.phoneme.in/auth/callback
PHONEME_AUTH_SCOPES=openid profile email
PHONEME_AUTH_TOKEN_AUTH=post

# --- role mapping ------------------------------------------------------------
# The claim that carries group membership in the ID token, and the group names
# the auth team will issue. Adjust to match what Phoneme Auth actually sends.
PHONEME_AUTH_GROUP_CLAIM=groups
PHONEME_AUTH_ADMIN_GROUP=lms-admins
PHONEME_AUTH_COORDINATOR_GROUP=lms-coordinators

# Only company accounts may sign in. Leave empty to allow any verified account.
PHONEME_AUTH_ALLOWED_DOMAIN=phoneme.in

# Which workspace SSO users land in. Create it once with the setup wizard or
# set it to the slug you used there.
PHONEME_TENANT_SLUG=phoneme

# Button label on the sign-in screen.
PHONEME_AUTH_BUTTON_LABEL=Continue with Phoneme

# 1 = keep the local email/password form as a break-glass owner login.
# Set to 0 once SSO admin access is confirmed working.
PHONEME_AUTH_LOCAL_LOGIN=1

# Where the IdP sends the user after logout (must be registered there too).
PHONEME_AUTH_POST_LOGOUT_REDIRECT=https://lms.phoneme.in
