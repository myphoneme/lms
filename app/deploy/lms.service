[Unit]
Description=L1 Academy (lms.phoneme.in)
Documentation=https://github.com/myphoneme/lms
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lms
Group=lms
WorkingDirectory=/opt/lms/current/app
EnvironmentFile=/etc/lms/lms.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=15

# Hardening: the app only writes to the data directory.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/lms
UMask=0077
CapabilityBoundingSet=
LockPersonality=true
# MemoryDenyWriteExecute is deliberately NOT set: V8 JIT needs writable executable
# pages, and Node exits immediately when systemd denies them.

[Install]
WantedBy=multi-user.target
